ãna,"},{"p":7,"v":"oiuúca"},{"p":8,"v":"ãna"},{"p":9,"v":"i"},{"bid":"bid#1","p":10,"v":"mẹmɨ."}],"chunks":[{"i":1,"f":10,"t":"IP-MAT"}]},"translations":{"pt-BR":"O jabuti esperou até apodrecer depois de, e tirou sua flauta."},"text":"Iáutí oçarú nhum iúca riré ãna, oiuúca ãna i mẹmɨ."},{"uid":"74097e5b-a284-4fe5-ab93-91ddbe88461d","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"p":1,"v":"Aramé"},{"p":2,"v":"iáutí"},{"p":3,"v":"oçộ"},{"p":4,"v":"anã,"},{"p":5,"v":"opeiú"},{"p":6,"v":"i"},{"p":7,"v":"mẹmɨ,"},{"p":8,"v":"quaié"},{"p":9,"v":"onheengári:"},{"p":10,"v":"—"},{"p":11,"v":"Iauaraẹtệ"},{"p":12,"v":"cãuệra"},{"p":13,"v":"ceremẹ"},{"bid":"bid#1","p":14,"v":"mɨ'."}],"chunks":[{"i":1,"f":14,"t":"IP-MAT"}]},"translations":{"pt-BR":"Então o jabuti foi-se, tocava sua flauta, assim cantava: — Da onça o osso e a minha flauta."},"text":"Aramé iáutí oçộ anã, opeiú i mẹmɨ, quaié onheengári: — Iauaraẹtệ cãuệra ceremẹ mɨ'."},{"uid":"1263a673-b89b-455f-9dd2-1f5e30c4e012","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"p":1,"v":"—"},{"bid":"bid#1","p":2,"v":"ih!"}],"chunks":[{"i":1,"f":2,"t":"IP-MAT"}]},"translations":{"pt-BR":"— ih!"},"text":"— ih!"},{"uid":"bceb1d35-05ba-46d3-b88d-41b920877de8","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"p":1,"v":"—"},{"bid":"bid#1","p":2,"v":"ih?"}],"chunks":[{"i":1,"f":2,"t":"IP-MAT"}]},"translations":{"pt-BR":"— ih?"},"text":"— ih?"}]}]}
ordaram-se, e quando avistaram-se, a onça disse ao veado: — Era você que estava me ajudando?"},"text":"Amú ára opé aitá opáca; aitá oiumahã ramé, iauáraẹtệ onhehẽ çuaçú çupé: — Indệ será repuraukệ uahá cẹ irúmo?"},{"uid":"920a32e2-44ee-4c10-8bb3-a22e25b6a200","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"p":1,"v":"Çuaçú"},{"p":2,"v":"oçuaxára:"},{"p":3,"v":"—"},{"p":4,"v":"Ixệ"},{"p":5,"v":"ahé"},{"bid":"bid#1","p":6,"v":"tenhẽ."}],"chunks":[{"i":1,"f":6,"t":"IP-MAT"}]},"translations":{"pt-BR":"O veado respondeu: — Era eu mesmo."},"text":"Çuaçú oçuaxára: — Ixệ ahé tenhẽ."},{"uid":"b1654478-814a-44f0-9787-af5257c50d66","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"p":1,"v":"Iauáraẹtệ"},{"p":2,"v":"onhehẽ:"},{"p":3,"v":"—"},{"p":4,"v":"Cuhɨre"},{"p":5,"v":"iaçộ"},{"p":6,"v":"iapɨtá"},{"p":7,"v":"iépé"},{"bid":"bid#1","p":8,"v":"açú."}],"chunks":[{"i":1,"f":8,"t":"IP-MAT"}]},"translations":{"pt-BR":"A onça disse: — Pois bem, agora vamos morar juntos."},"text":"Iauáraẹtệ onhehẽ: — Cuhɨre iaçộ iapɨtá iépé açú."},{"uid":"d95640ff-8bfa-40b2-be55-d97b98c39c5e","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"p":1,"v":"Çuaçú"},{"p":2,"v":"oçuaxára:"},{"p":3,"v":"—"},{"bid":"bid#1","p":4,"v":"Iaçộ."}],"chunks":[{"i":1,"f":4,"t":"IP-MAT"}]},"translations":{"pt-BR":"O veado disse: — Vamos."},"text":"Çuaçú oçuaxára: — Iaçộ."},{"uid":"0c1aac26-6b34-47b8-b760-b6f41c465dd5","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"p":1,"v":"Amú"},{"p":2,"v":"ára"},{"p":3,"v":"upé"},{"p":4,"v":"iauáraẹtệ"},{"p":5,"v":"onhehẽ:"},{"p":6,"v":"—"},{"p":7,"v":"Xa"},{"p":8,"v":"çộ"},{"p":9,"v":"xa"},{"bid":"bid#1","p":10,"v":"cahámunũ."}],"chunks":[{"i":1,"f":10,"t":"IP-MAT"}]},"translations":{"pt-BR":"No outro dia a onça disse: — Eu vou caçar."},"text":"Amú ára upé iauáraẹtệ onhehẽ: — Xa çộ xa cahámunũ."},{"uid":"83b9d51f-2ac6-4ea9-8248-fd9de61cf83d","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"p":1,"v":"Indệ"},{"p":2,"v":"rẹiúcí"},{"p":3,"v":"quahá"},{"p":4,"v":"mɨrá"},{"p":5,"v":"rupitá"},
},{"p":16,"v":"ixệ"},{"bid":"bid#1","p":17,"v":"arãma."}],"chunks":[{"i":1,"f":17,"t":"IP-MAT"}]},"translations":{"pt-BR":"No outro dia veio a onça e disse: — Tupã está me ajudando."},"text":"Amú ára opé iauárẹtệ oúri, omahã ramé tenáua oiúcupíri ãna, onhehẽ: — Tupãna opuraukệ oikộ ixệ arãma."},{"uid":"ba5e609d-72f3-40a8-8cb4-32d55e4b41dd","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"p":1,"v":"Iatɨcá"},{"p":2,"v":"tiãnha,"},{"p":3,"v":"oiúpirú"},{"p":4,"v":"úca"},{"p":5,"v":"(óca),"},{"p":6,"v":"ariré"},{"p":7,"v":"oçộ"},{"bid":"bid#1","p":8,"v":"ãna."}],"chunks":[{"i":1,"f":8,"t":"IP-MAT"}]},"translations":{"pt-BR":"Afincou as forquilhas, armou a casa."},"text":"Iatɨcá tiãnha, oiúpirú úca (óca), ariré oçộ ãna."},{"uid":"6e5e5ec4-0d12-4f6a-ba61-2fbc157f5d0f","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"p":1,"v":"Amú"},{"p":2,"v":"ára"},{"p":3,"v":"riré"},{"p":4,"v":"çuaçú"},{"p":5,"v":"oúri,"},{"p":6,"v":"onhehẽ:"},{"p":7,"v":"—"},{"p":8,"v":"Tupãna"},{"p":9,"v":"opuraukệ"},{"p":10,"v":"oikộ"},{"p":11,"v":"ixệ"},{"bid":"bid#1","p":12,"v":"arãma."}],"chunks":[{"i":1,"f":12,"t":"IP-MAT"}]},"translations":{"pt-BR":"No outro dia veio o veado e disse: — Tupã está me ajudando."},"text":"Amú ára riré çuaçú oúri, onhehẽ: — Tupãna opuraukệ oikộ ixệ arãma."},{"uid":"b6121a09-7184-433e-860e-40a40346634c","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"p":1,"v":"Pupéca"},{"p":2,"v":"ậna"},{"p":3,"v":"óca,"},{"p":4,"v":"omunhã"},{"p":5,"v":"mukuĩ"},{"p":6,"v":"ocapí;"},{"p":7,"v":"iépé"},{"p":8,"v":"ixupé;"},{"p":9,"v":"amũ"},{"p":10,"v":"Tupãna"},{"p":11,"v":"çupé;"},{"p":12,"v":"oçộ"},{"bid":"bid#1","p":13,"v":"ãna."}],"chunks":[{"i":1,"f":13,"t":"IP-MAT"}]},"translations":{"pt-BR":"Cobriu a casa e fez dois cômodos: um para si, outro para Tupã."},"text":"Pupéca ậna óca, omunhã mukuĩ ocapí; iépé ixupé; amũ Tupãna çupé; oçộ ãna."},{"uid":"9f34da9c-f21c-4be3-9c04-e25a27d51297","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"p":1,"v":"Amú"},{"p":2,"v":"ára"},{"p":3,"v":"opé,
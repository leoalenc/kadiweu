":[{"i":1,"f":10,"t":"IP-MAT"}]},"translations":{"pt-BR":"Andando estava mato pelo, ouviu barulho assim: Txau! txau! txau!"},"text":"Ouatá oikộ cahá rupí, ocenõ teapú quaié: Txáu! txáu! txáu!"},{"uid":"361ac8fe-4ef2-416d-bf1f-0814cacc9620","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"tid":"mWKd","p":1,"v":"—"},{"tid":"hcxy","p":2,"v":"Mãháta"},{"bid":"bid#1","tid":"Vk1g","p":3,"v":"ahé?"}],"chunks":[{"i":1,"f":3,"t":"IP-MAT"}],"conllu":[{"form":"—","misc":"TokenRange=0:1","id":"1"},{"form":"Mãháta","misc":"TokenRange=1:7","id":"2"},{"form":"ahé?","misc":"TokenRange=7:11","id":"3"}]},"translations":{"pt-BR":"— O que será?"},"text":"— Mãháta ahé?"},{"uid":"ba3b5687-658b-4c72-98ee-8b17d1f2787c","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"p":1,"v":"Omãhã,"},{"p":2,"v":"oxipiá"},{"p":3,"v":"mɨcúra"},{"p":4,"v":"oiuúca"},{"p":5,"v":"oikộ"},{"p":6,"v":"xipó"},{"bid":"bid#1","p":7,"v":"uahá."}],"chunks":[{"i":1,"f":7,"t":"IP-MAT"}]},"translations":{"pt-BR":"Olhou, e viu a raposa tirando estava cipó que."},"text":"Omãhã, oxipiá mɨcúra oiuúca oikộ xipó uahá."},{"uid":"06f76d61-e0be-47cc-954e-5321f400fea3","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"p":1,"v":"Mɨcúra"},{"p":2,"v":"oxipiá"},{"p":3,"v":"ramé"},{"p":4,"v":"ahé,"},{"p":5,"v":"onhehẽ:"},{"p":6,"v":"—"},{"p":7,"v":"Cuhɨre"},{"p":8,"v":"puxiãna"},{"p":9,"v":"xa"},{"p":10,"v":"ikộ;"},{"p":11,"v":"iauáraté,"},{"p":12,"v":"ipộ,"},{"p":13,"v":"óú"},{"p":14,"v":"curi"},{"bid":"bid#1","p":15,"v":"ixệ!"}],"chunks":[{"i":1,"f":15,"t":"IP-MAT"}]},"translations":{"pt-BR":"A raposa viu quando ela, disse: — Agora mal eu estou; a onça, pode ser, comer-me-á!"},"text":"Mɨcúra oxipiá ramé ahé, onhehẽ: — Cuhɨre puxiãna xa ikộ; iauáraté, ipộ, óú curi ixệ!"},{"uid":"df2b760c-b592-44e5-b833-af94d2a85ab5","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"p":1,"v":"Onhehẽ"},{"p":2,"v":"iauáraté"},{"p":3,"v":"çupé:"},{"p":4,"v":"—"},{"p":5,"v":"Iuɨtú-aɨua"},{"p":6,"v":"oúri"},{"p":7,"v":"oikộ;"},{"p":8,"v":"indệ"},{"p":9,"v":"rẹpɨt
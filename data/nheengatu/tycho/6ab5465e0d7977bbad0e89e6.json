{"document":{"id":"671172f7b8eb2f25a7b36856","uid":"36aed259-d913-47d0-b4c8-0b67f328a8fd","name":"Cunhã mucu oço uahá ocicári mena","corpus":"eb9339bc-ecec-4486-9296-b98546a9a9db","status":"EDITING","translated":"A moça que vai procurar\tmarido","category":"ff4c0ba4-fdc7-49dd-96e0-6684d086fdf1","reference":"tale_13c.txt","page":"b566c4d9-18e8-4d35-b287-c6ac322e8571","defaultTool":"TRANSLATION","visible":true},"pages":[{"uid":"b566c4d9-18e8-4d35-b287-c6ac322e8571","order":1,"sentences":[{"uid":"687445fc-7af6-404e-a850-7dbde614858c","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"p":1,"v":"Cunhã"},{"p":2,"v":"mucu"},{"p":3,"v":"oço"},{"p":4,"v":"uahá"},{"p":5,"v":"ocicári"},{"p":6,"v":"mena"}],"chunks":[{"i":1,"f":6,"t":"IP-MAT"}],"conllu":[{"form":"Cunhã","id":"1"},{"form":"mucu","id":"2"},{"form":"oço","id":"3"},{"form":"uahá","id":"4"},{"form":"ocicári","id":"5"},{"form":"mena","id":"6"}],"attributes":{"text_por":"A moça vai que procurar marido","text":"Cunhã mucu oço uahá ocicári mena"}},"translations":{"pt-BR":"A moça vai que procurar marido"},"text":"Cunhã mucu oço uahá ocicári mena"},{"uid":"55c11b0f-8b2d-46b1-89f3-e5b95d9d0adc","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"p":1,"v":"CUNHÃ"},{"p":2,"v":"MUCU"},{"bid":"bid#1","p":3,"v":"INAIÉ"}],"chunks":[{"i":1,"f":3,"t":"IP-MAT"}]},"translations":{"pt-BR":"A moça e o gavião"},"text":"CUNHÃ MUCU INAIÉ"},{"uid":"207c7f2c-5b6c-4802-a5fe-30581984225e","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"p":1,"v":"Ahé"},{"p":2,"v":"ocɨka"},{"p":3,"v":"ramé"},{"p":4,"v":"rauçapɨre"},{"p":5,"v":"pé"},{"p":6,"v":"upé,"},{"p":7,"v":"oçộ"},{"p":8,"v":"amú"},{"bid":"bid#1","p":9,"v":"rupí."}],"chunks":[{"i":1,"f":9,"t":"IP-MAT"}]},"translations":{"pt-BR":"Ela chegou quando três caminhos em, foi outro por."},"text":"Ahé ocɨka ramé rauçapɨre pé upé, oçộ amú rupí."},{"uid":"91322bc6-a4fa-4ea6-b9ef-70f410cb66db","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"p":1,"v":"Ocɨka"},{"p":2,"v":"óca"},{"p":3,"v":"upé,"},{"p":4,"v":"omahã"},{"p":5,"v":"iepé"},{"p":6,"v":"uáimĩ"},{"p":7,"v":"purãnga"},{"p":8,"v":"rẹtệ,"},{"p":9,"v":"opurauú"},{"p":10,"v":"ixuí:"},{"p":11,"v":"—"},{"p":12,"v":"Inệ"},{"p":13,"v":"inaié"},{"p":14,"v":"cɨ"},{"bid":"bid#1","p":15,"v":"será?"}],"chunks":[{"i":1,"f":15,"t":"IP-MAT"}]},"translations":{"pt-BR":"Chegou casa em, viu uma velha formosa muito, perguntou a ela: — Você é do inajé a mãe?"},"text":"Ocɨka óca upé, omahã iepé uáimĩ purãnga rẹtệ, opurauú ixuí: — Inệ inaié cɨ será?"},{"uid":"2bf40fdb-0861-42b7-aafa-dbae10dcd466","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"p":1,"v":"Uáimĩ"},{"p":2,"v":"oçuaxára:"},{"p":3,"v":"—"},{"p":4,"v":"Ixệ"},{"p":5,"v":"ahé"},{"bid":"bid#1","p":6,"v":"tenhẽ."}],"chunks":[{"i":1,"f":6,"t":"IP-MAT"}]},"translations":{"pt-BR":"A velha respondeu: — Eu sou ela mesma."},"text":"Uáimĩ oçuaxára: — Ixệ ahé tenhẽ."},{"uid":"099d6b7e-f30c-4215-bf1e-2988e2fe521a","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"p":1,"v":"Cunhã"},{"p":2,"v":"mucú"},{"p":3,"v":"onhehẽ:"},{"p":4,"v":"—"},{"p":5,"v":"Xa"},{"p":6,"v":"iúre"},{"p":7,"v":"ahé"},{"p":8,"v":"pɨre,"},{"p":9,"v":"xa"},{"p":10,"v":"mendári"},{"p":11,"v":"arãma"},{"p":12,"v":"ahé"},{"bid":"bid#1","p":13,"v":"irúmo."}],"chunks":[{"i":1,"f":13,"t":"IP-MAT"}]},"translations":{"pt-BR":"A moça disse: — Eu venho ele a, eu casar para ele com."},"text":"Cunhã mucú onhehẽ: — Xa iúre ahé pɨre, xa mendári arãma ahé irúmo."},{"uid":"9317effe-4303-46c5-8b78-a3cbcdd7275f","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"p":1,"v":"Uáimĩ"},{"p":2,"v":"onhehẽ:"},{"p":3,"v":"—"},{"p":4,"v":"Xa"},{"p":5,"v":"çộ"},{"p":6,"v":"xa"},{"p":7,"v":"uímimi"},{"p":8,"v":"indệ;"},{"p":9,"v":"cệ"},{"p":10,"v":"embɨra"},{"p":11,"v":"míra"},{"p":12,"v":"puxí"},{"bid":"bid#1","p":13,"v":"rẹtệ."}],"chunks":[{"i":1,"f":13,"t":"IP-MAT"}]},"translations":{"pt-BR":"A velha disse: — Eu vou esconder você, meu filho gente é brava muito."},"text":"Uáimĩ onhehẽ: — Xa çộ xa uímimi indệ; cệ embɨra míra puxí rẹtệ."},{"uid":"c62876d8-92c8-4813-b8d2-695c569ab3b9","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"p":1,"v":"Caárúka"},{"p":2,"v":"ramé,"},{"p":3,"v":"embɨra"},{"p":4,"v":"ocɨka,"},{"p":5,"v":"orúri"},{"p":6,"v":"ximiára"},{"p":7,"v":"cệtá:"},{"p":8,"v":"uirá"},{"p":9,"v":"mirĩtá,"},{"p":10,"v":"I"},{"p":11,"v":"cɨ"},{"p":12,"v":"omungaturú"},{"p":13,"v":"uirá"},{"p":14,"v":"mirĩtá"},{"p":15,"v":"aitá"},{"p":16,"v":"óú"},{"bid":"bid#1","p":17,"v":"arãma."}],"chunks":[{"i":1,"f":17,"t":"IP-MAT"}]},"translations":{"pt-BR":"Tarde em, seu filho chegou, trouxe caça muita: pássaros pequenos, Sua mãe aprontou pássaros pequenos, eles comerem para."},"text":"Caárúka ramé, embɨra ocɨka, orúri ximiára cệtá: uirá mirĩtá, I cɨ omungaturú uirá mirĩtá aitá óú arãma."},{"uid":"dee2d223-69c0-4e3b-a107-28a546e127d2","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"p":1,"v":"Aitá"},{"p":2,"v":"óú"},{"p":3,"v":"oikộ"},{"p":4,"v":"ramé"},{"p":5,"v":"i"},{"p":6,"v":"cɨ"},{"p":7,"v":"opuranú"},{"p":8,"v":"ixuí:"},{"p":9,"v":"—"},{"p":10,"v":"Auá"},{"p":11,"v":"çupé"},{"p":12,"v":"ocɨka"},{"p":13,"v":"uahá"},{"p":14,"v":"ramẽ,"},{"p":15,"v":"amú"},{"p":16,"v":"tetãma"},{"p":17,"v":"çuí,"},{"p":18,"v":"mãháta"},{"p":19,"v":"rẹmunhã"},{"bid":"bid#1","p":20,"v":"ixupé?"}],"chunks":[{"i":1,"f":20,"t":"IP-MAT"}]},"translations":{"pt-BR":"Eles comendo estavam quando sua mãe perguntou a ele: — A quem chegar que quando, outra pátria de,  o que farás a ele?"},"text":"Aitá óú oikộ ramé i cɨ opuranú ixuí: — Auá çupé ocɨka uahá ramẽ, amú tetãma çuí, mãháta rẹmunhã ixupé?"},{"uid":"cdc39bad-4271-491f-961d-ddcd3b947d3f","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"p":1,"v":"Inaié"},{"p":2,"v":"oçuaxára:"},{"p":3,"v":"—"},{"p":4,"v":"Xa"},{"p":5,"v":"cẹnõĩ"},{"p":6,"v":"ahé"},{"p":7,"v":"óú"},{"p":8,"v":"arãma"},{"p":9,"v":"ianệ"},{"bid":"bid#1","p":10,"v":"irúmo."}],"chunks":[{"i":1,"f":10,"t":"IP-MAT"}]},"translations":{"pt-BR":"O inajé respondeu: — Eu chamo ele comer para nós com."},"text":"Inaié oçuaxára: — Xa cẹnõĩ ahé óú arãma ianệ irúmo."},{"uid":"652b0554-11ab-4e2b-b785-b37ef0aa9e1b","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"p":1,"v":"Aramé"},{"p":2,"v":"uáimĩ"},{"p":3,"v":"ocenộɨ"},{"p":4,"v":"cunhã"},{"bid":"bid#1","p":5,"v":"mucú."}],"chunks":[{"i":1,"f":5,"t":"IP-MAT"}]},"translations":{"pt-BR":"Então a velha chamou a moça."},"text":"Aramé uáimĩ ocenộɨ cunhã mucú."},{"uid":"90e30fc3-81fd-41e4-b6fe-4da82325dc02","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"p":1,"v":"Inaié"},{"p":2,"v":"çộrí"},{"p":3,"v":"rẹtệ,"},{"p":4,"v":"cunhã"},{"p":5,"v":"mucú"},{"p":6,"v":"purãnga"},{"p":7,"v":"rẹte"},{"bid":"bid#1","p":8,"v":"rẹcệ."}],"chunks":[{"i":1,"f":8,"t":"IP-MAT"}]},"translations":{"pt-BR":"O inajé alegre ficou muito, a moça era bonita muito porque."},"text":"Inaié çộrí rẹtệ, cunhã mucú purãnga rẹte rẹcệ."},{"uid":"169323e8-8067-4a9d-b681-4e05f3e7f708","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"p":1,"v":"Aitá"},{"p":2,"v":"okệri"},{"p":3,"v":"uãna"},{"bid":"bid#1","p":4,"v":"iépeuaçú."}],"chunks":[{"i":1,"f":4,"t":"IP-MAT"}]},"translations":{"pt-BR":"Eles dormiram juntos."},"text":"Aitá okệri uãna iépeuaçú."},{"uid":"abdc16a5-9abe-4edb-8ad7-e7d7040fb97f","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"p":1,"v":"Amú"},{"p":2,"v":"ára"},{"p":3,"v":"upé"},{"p":4,"v":"urubú"},{"p":5,"v":"ocɨka"},{"p":6,"v":"inaié"},{"p":7,"v":"óca"},{"p":8,"v":"upé,"},{"p":9,"v":"ocicári"},{"p":10,"v":"arãma"},{"p":11,"v":"cunhã"},{"bid":"bid#1","p":12,"v":"mucú."}],"chunks":[{"i":1,"f":12,"t":"IP-MAT"}]},"translations":{"pt-BR":"Outro dia em o corvo chegou do inajé casa em, procurar para a moça."},"text":"Amú ára upé urubú ocɨka inaié óca upé, ocicári arãma cunhã mucú."},{"uid":"0e624d57-2e71-4666-b990-d18e3e0bcded","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"p":1,"v":"Aitá"},{"p":2,"v":"omuramunhã"},{"p":3,"v":"uãna"},{"p":4,"v":"rẹtệ"},{"p":5,"v":"cunhã"},{"p":6,"v":"múcú"},{"bid":"bid#1","p":7,"v":"rẹcệ."}],"chunks":[{"i":1,"f":7,"t":"IP-MAT"}]},"translations":{"pt-BR":"Eles brigaram muito da moça por causa."},"text":"Aitá omuramunhã uãna rẹtệ cunhã múcú rẹcệ."},{"uid":"3e2243cc-9c5a-4955-9e1b-8036c4cb709b","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"p":1,"v":"Inaié"},{"p":2,"v":"ompúca"},{"p":3,"v":"ãna"},{"p":4,"v":"urubú"},{"bid":"bid#1","p":5,"v":"akãnga."}],"chunks":[{"i":1,"f":5,"t":"IP-MAT"}]},"translations":{"pt-BR":"O inajé quebrou do urubu a cabeça."},"text":"Inaié ompúca ãna urubú akãnga."},{"uid":"42268abd-5cf1-4cda-a2d3-1b4393c409ba","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"p":1,"v":"I"},{"p":2,"v":"cɨ"},{"p":3,"v":"omuacú"},{"p":4,"v":"uãna"},{"p":5,"v":"ɨ,"},{"p":6,"v":"muiáçúca"},{"p":7,"v":"i"},{"p":8,"v":"akãnga;"},{"p":9,"v":"ɨ"},{"p":10,"v":"çacú"},{"p":11,"v":"rẹtệ"},{"p":12,"v":"uãna:"},{"p":13,"v":"aárẹcệ"},{"p":14,"v":"i"},{"p":15,"v":"akãnga"},{"p":16,"v":"çáuaɨma"},{"p":17,"v":"opɨtá"},{"p":18,"v":"opaɨ"},{"p":19,"v":"ára"},{"bid":"bid#1","p":20,"v":"upé."}],"chunks":[{"i":1,"f":20,"t":"IP-MAT"}]},"translations":{"pt-BR":"Sua mãe (do urubu) esquentou água, lavou sua cabeça; água quente estava muitíssimo: por isso sua cabeça depenada ficou todo tempo em (para sempre)."},"text":"I cɨ omuacú uãna ɨ, muiáçúca i akãnga; ɨ çacú rẹtệ uãna: aárẹcệ i akãnga çáuaɨma opɨtá opaɨ ára upé."}]}]}
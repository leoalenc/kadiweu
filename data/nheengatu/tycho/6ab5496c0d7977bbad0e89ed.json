39223},"translations":{"pt-BR":"Eles chegaram, o sinimbú mandou sua mulher tirar cipó para ele."},"text":"Aitá ocɨka, cinimũ omundú ximirệcộ oiuúca xipó ixupé."},{"uid":"fb7a62ed-708f-4a5e-a796-2463b291865c","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"p":1,"v":"Ahé"},{"p":2,"v":"oiupɨri"},{"p":3,"v":"mɨrá"},{"p":4,"v":"rẹcệ,"},{"p":5,"v":"onhehẽ"},{"p":6,"v":"ximirẹcộ"},{"p":7,"v":"çupé:"},{"p":8,"v":"—"},{"p":9,"v":"Remuatɨri"},{"p":10,"v":"cahá"},{"p":11,"v":"ceiía;"},{"p":12,"v":"ceiía"},{"p":13,"v":"ramé"},{"p":14,"v":"ãna,"},{"p":15,"v":"remundɨca"},{"p":16,"v":"tatá"},{"attributes":{"gloss-br":"ele"},"p":17,"v":"i","t":"PRO"},{"bid":"bid#1","p":18,"v":"rẹcệ."}],"chunks":[{"i":1,"f":18,"t":"IP-MAT"}],"parsed":1784326540171},"translations":{"pt-BR":"Ele subiu árvore sobre, disse sua mulher a: — Amontoe folha muita; muita quando tiver, acenda fogo ela sobre."},"text":"Ahé oiupɨri mɨrá rẹcệ, onhehẽ ximirẹcộ çupé: — Remuatɨri cahá ceiía; ceiía ramé ãna, remundɨca tatá i rẹcệ."},{"uid":"b2686cd0-04c4-4dbd-90d8-1c1ef0907975","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"p":1,"v":"Cunhã"},{"p":2,"v":"mucú"},{"p":3,"v":"omunhã"},{"p":4,"v":"maí"},{"p":5,"v":"cinimú"},{"p":6,"v":"omundú"},{"bid":"bid#1","p":7,"v":"ãna."}],"chunks":[{"i":1,"f":7,"t":"IP-MAT"}],"parsed":1784326541087},"translations":{"pt-BR":"A moça fez como o sinimbú mandou."},"text":"Cunhã mucú omunhã maí cinimú omundú ãna."},{"uid":"e28762d4-ded6-443a-b072-8cc543c2f6ec","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"p":1,"v":"Tatá"},{"p":2,"v":"turuçú"},{"p":3,"v":"ãna"},{"p":4,"v":"ramé,"},{"p":5,"v":"cinimũ"},{"p":6,"v":"onhehẽ"},{"p":7,"v":"ɨuaté"},{"p":8,"v":"çuí:"},{"p":9,"v":"—"},{"p":10,"v":"Aiqué"},{"p":11,"v":"xa"},{"bid":"bid#1","p":12,"v":"çộ!"}],"chunks":[{"i":1,"f":12,"t":"IP-MAT"}],"parsed":1784326541993},"translations":{"pt-BR":"O fogo grande já quando, o sinimbú disse de cima: — Lá me vou!"},"text":"Tatá turuçú ãna ramé, cinimũ onhehẽ ɨuaté çuí: — Aiqué xa çộ!"},{"uid":"97239feb-547c-46e8-8ff0-91421f79be17","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"p":1,"v":"Opúri"},{"p":2,"v":"tatá"},{"p":3,"v":"pɨtệrape,"},{"p":4,"v":"oiapumĩ"},{"p":5,"v":"ɨ"},{"p":6,"v":"pupé,"},{"p":7,"v":"uíre"},{"p":8,"v":"çuáindápe,"},{"p":9,"v":"oçapucái"},{"p":10,"v":"ximirẹcộ"},{"p":11,"v":"rẹcệ:"},{"p":12,"v":"—"},{"p":13,"v":"Rẹrúri"},{"p":14,"v":"ɨgára,"},{"p":15,"v":"pucɨ"},{"p":16,"v":"rẹtệ"},{"p":17,"v":"quahá"},{"bid":"bid#1","p":18,"v":"pirá!"}],"chunks":[{"i":1,"f":18,"t":"IP-MAT"}],"parsed":1784326542920},"translations":{"pt-BR":"Pulou do fogo meio em, mergulhou água na, baiou do outro lado, gritou sua mulher por: — Traga a canoa, pesado muito é este peixe!"},"text":"Opúri tatá pɨtệrape, oiapumĩ ɨ pupé, uíre çuáindápe, oçapucái ximirẹcộ rẹcệ: — Rẹrúri ɨgára, pucɨ rẹtệ quahá pirá!"},{"uid":"bf6b4cd1-c396-4d71-9061-a9d55b9ac6ee","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"p":1,"v":"Aitá"},{"p":2,"v":"oiuruári"},{"p":3,"v":"ãna"},{"p":4,"v":"tucunaré"},{"p":5,"v":"uaçú"},{"p":6,"v":"irúmo,"},{"p":7,"v":"oçộ"},{"p":8,"v":"ãna"},{"p":9,"v":"çộka"},{"p":10,"v":"kẹtệ;"},{"p":11,"v":"aápe"},{"p":12,"v":"cunhã"},{"p":13,"v":"mucú"},{"p":14,"v":"omehẽ"},{"p":15,"v":"nhahã"},{"p":16,"v":"pirá"},{"p":17,"v":"mɨcúra"},{"bid":"bid#1","p":18,"v":"çupé."}],"chunks":[{"i":1,"f":18,"t":"IP-MAT"}],"parsed":1784326543854},"translations":{"pt-BR":"Eles embarcaram-se tucunaré grande com, foram-se sua casa para; lá a moça deu esse peixe raposa a."},"text":"Aitá oiuruári ãna tucunaré uaçú irúmo, oçộ ãna çộka kẹtệ; aápe cunhã mucú omehẽ nhahã pirá mɨcúra çupé."},{"uid":"f0513dc5-2211-4b07-912c-b01400448353","breaks":[{"id":"bid#1"}],"struct":{"tokens":[{"p":1,"v":"Mɨcúra"},{"p":2,"v":"opuranú"},{"p":3,"v":"maí"},{"attributes":{"gloss-br":"ele"},"p":4,"v":"i","t":"PRO"},{"p":5,"v":"mệna"},{"p":6,"v":"opicɨka"},{"p":7,"v":"uãna"},{"bid":"bid#1","p":8,"v":"pirá."}],"chunks":[{"i":1,"f":8,"t":"IP-MAT"}],"parsed":1784326544781},"translations":{"pt-BR":"A raposa perguntou co
/*
sentence = 15
uid = 4c41fdf6-0c48-4eb6-91f7-121c21f3e2a7
status = REVIEW
text = Nigaanigawaanigi idei madi niwatece ane adi nomiigo
text_por = O menino está na canoa que (tem) o anzol
*/
(
  (IP-MAT
    (NP
      (N Nigaanigawaanigi)
    )
    (VB idei)
    (CP-me
      (C me@)
      (IP-SUB
        (NP
          (D @adi)
          (N$ niwatece)
        )
      )
    )
    (NP
      (CP-FRL
        (WNP-1
          (WPRO ane)
        )
        (IP-SUB
          (NP-TRACE
            (-NONE- *T*-1)
          )
          (NP
            (D adi)
            (N nomiigo)
          )
        )
      )
    )
  )
  (ID van-data,0.15)
)


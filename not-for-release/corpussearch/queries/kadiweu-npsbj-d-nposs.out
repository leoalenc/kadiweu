/~*
NiGijo liwenigi libinienigi
(hil-data,0.8)
*~/
/*
2 NP-SBJ:  3 D, 5 N$
*/
( (IP-MAT (NP-SBJ (D NiGijo) (N$ liwenigi))
	  (NP-PRD (N$ libinienigi)))
  (ID hil-data,0.8))

/~*
NaGajo lomigo niganigawanigi me@ @adi niwatece
(hil-data,0.11)
*~/
/*
2 NP-SBJ:  3 D, 5 N$
*/

( (IP-MAT (NP-SBJ (D NaGajo)
		  (N$ lomigo)
		  (NP (N niganigawanigi)))
	  (CP-me (C me@)
		 (IP-SUB (NP (D @adi) (N$ niwatece)))))
  (ID hil-data,0.11))


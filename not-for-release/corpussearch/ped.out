/~*
ica Maria looligi aG@ @lidi
(ped-gramm,0.11)
*~/
/*
2 NP-SBJ:  2 NP-SBJ, 7 N$, 5 NPR
*/
( (IP-MAT (NP-SBJ (D ica) (NPR Maria) (N$ looligi))
	  (NEG aG@)
	  (NP-PRD (N$ @lidi)))
  (ID ped-gramm,0.11))

/~*
João liGeladi ane napioi
(ped-gramm,0.26)
*~/
/*
2 NP:  2 NP, 5 N$, 3 NPR
*/

( (IP-MAT (NP (NPR João)
	      (N$ liGeladi)
	      (CP-REL (WNP-1 (WPRO ane))
		      (IP-SUB (NP-TRACE (-NONE- *T*-1))
			      (NP (N napioi))))))
  (ID ped-gramm,0.26))

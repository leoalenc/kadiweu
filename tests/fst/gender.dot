/* Net:  */
digraph no_name {
charset="utf-8";
rankdir = LR ;
rotate=90 ;
ranksep =".15" ;
/* default shape for nodes */
node[shape=circle,fixedsize=true,fontsize="10",height=".35"] ;
/* default size for arc labels */
edge[fontsize="12"];

0;
0 -> 1 [label="a i",fontsize="12"];
1 [shape=doublecircle,height=".27",label="1"];
}
